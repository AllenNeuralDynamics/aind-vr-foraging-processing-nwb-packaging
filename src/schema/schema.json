{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NWB Event Description Schema",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "Date and time when the data was recorded"
    },
    "events": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["string", "number", "integer", "boolean", "array", "object", "null"]
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": ["string", "number", "integer", "boolean", "array", "object", "null"]
                },
                "minItems": 2,
                "maxItems": 2,
                "contains": {
                  "const": "null"
                }
              }
            ],
            "description": "JSON Schema type - can be a single type or nullable type [type, null]"
          },
          "description": {
            "type": "string",
            "description": "Human-readable description of the item"
          },
          "implementation_details": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Implementation detail or reference",
            "default": null
          },
          "unit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Unit of measurement or specification",
            "default": null
          }
        },
        "required": [
          "type",
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "date",
    "events"
  ],
  "additionalProperties": false
}